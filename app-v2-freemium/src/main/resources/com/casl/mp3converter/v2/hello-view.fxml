<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.casl.mp3converter.v2.ControllerV2">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="headerLabel" text="Convertidor a MP3 (versión gratuita)" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="10.0" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints minWidth="150.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="240.0"/>
        </columnConstraints>

        <Button fx:id="btnSource" text="Carpeta origen..." onAction="#onSelectSourceFolder"
                GridPane.rowIndex="0" GridPane.columnIndex="0" maxWidth="Infinity"/>
        <Label fx:id="sourcePathLabel" text="No seleccionada"
               style="-fx-text-fill: gray;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Button fx:id="btnDestination" text="Carpeta destino..." onAction="#onSelectDestinationFolder"
                GridPane.rowIndex="1" GridPane.columnIndex="0" maxWidth="Infinity"/>
        <Label fx:id="destinationPathLabel" text="No seleccionada"
               style="-fx-text-fill: gray;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Button fx:id="btnConvert" text="Convertir a MP3" onAction="#onStartConversion"
            defaultButton="true" maxWidth="Infinity" style="-fx-font-size: 14px;"/>

    <Button fx:id="btnBuyPro" text="Comprar versión Pro" onAction="#onBuyPro"
            maxWidth="Infinity" style="-fx-font-size: 12px; -fx-font-color: darkorange;"/>

    <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0"/>
    <Label fx:id="statusLabel" text="Listo." style="-fx-text-fill: gray;"/>

    <HBox alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="versionLabel" text="MP3Converter version 2.0.0 · Versión gratuita · 92 kbps"
               style="-fx-font-size: 10px; -fx-text-fill: gray;"/>
    </HBox>
</VBox>
